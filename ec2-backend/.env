# Flask Configuration
FLASK_ENV=production
PORT=5000
SECRET_KEY=dev-secret-key-medicine-tracker-nie-mysore-2026

# CORS Allowed Origins (* allows any domain/EC2 IP, or set to http://<FRONTEND_EC2_IP>)
FRONTEND_URL=*

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-medicine-tracker-nie-mysore-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (MySQL / AWS RDS / Google Cloud SQL)
# Update this with your local or AWS RDS MySQL credentials:
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medicine_tracker

# Local Fallback Flag (Defaults to True so the app runs immediately even if MySQL service isn't started)
# Change to False once you create your MySQL database!
USE_SQLITE=True
SQLITE_DB_NAME=medicine_tracker.db

# Email Alerts Configuration (Flask-Mail / SMTP)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=pharmacy.alerts.nie@gmail.com
MAIL_PASSWORD=your_app_password_here
MAIL_DEFAULT_SENDER="Medicine Stock Alert <noreply@medstock.cloud>"

# Scheduler Configuration (Daily Expiry/Low-Stock Check)
SCHEDULER_DAILY_RUN_HOUR=8
SCHEDULER_DAILY_RUN_MINUTE=0
