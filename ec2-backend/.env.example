# ==============================================================================
# Medicine Stock & Expiry Tracker - Environment Configuration
# ==============================================================================

# Flask Configuration
FLASK_ENV=production
PORT=5000
SECRET_KEY=super-secret-medicine-tracker-key-change-in-production

# CORS Allowed Origins (* allows any domain/EC2 IP, or set to http://<FRONTEND_EC2_IP>)
FRONTEND_URL=*

# JWT Authentication
JWT_SECRET_KEY=jwt-secret-key-change-in-production-2026
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database Configuration (MySQL / AWS RDS / Google Cloud SQL)
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/medicine_tracker

# Optional Fallback to SQLite (set USE_SQLITE=True if MySQL is not installed locally)
USE_SQLITE=False
SQLITE_DB_NAME=medicine_tracker.db

# Email Alerts Configuration (SMTP - e.g. Gmail / SendGrid / Amazon SES)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-pharmacy-alerts@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=Medicine Stock Alert <noreply@medstock.cloud>

# Scheduler Configuration (Daily check run time in 24-hr format)
SCHEDULER_DAILY_RUN_HOUR=8
SCHEDULER_DAILY_RUN_MINUTE=0
